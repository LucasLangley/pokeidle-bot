# Copie para .env e preencha. Nunca compartilhe o .env: o token é a sua sessão no jogo.
POKEIDLE_NICK=
POKEIDLE_TOKEN=
# opcional: o id do seu navegador (localStorage "id-dispositivo"); vazio = gera um novo
POKEIDLE_DISPOSITIVO=

# 1 = conecta e só mostra o que faria (ainda assim derruba o jogo aberto no navegador)
SOMENTE_LER=0

# captura: vip (padrão: só o Auto-Catch do servidor, precisa de VIP) | sempre | time | rajada (o bot lança sozinho; sem VIP pode ser visto como burlar benefício pago) | 0
CAPTURAR=vip
RAJADA_MS=3000
BOLA_RESERVA=20
MIN_POCOES=60
MIN_REVIVES=10
MIN_BOLAS=100
GASTO_MAX_FRACAO=0.4
AUTO_VENDA=1

# hunt
MARGEM_NIVEL=0
# hunt no máximo N níveis acima do pokemon ativo (com boost de XP o treinador sobe mais rápido que o pokemon)
HUNT_ACIMA_POKEMON=20
# auto = todas as áreas menos a Outland, conforme o nível alcança cada uma (Johto fica dentro de kanto); ou uma lista fixa, ex.: kanto,orre
REGIOES=auto
HUNT_FIXA=
MORTES_PARA_RECUAR=3
OUTLAND_DE=150
OUTLAND_ATE=199
HUNT_POR_TIPO=1
# entre as hunts de tipo bom (até 10% pior que a melhor), fica na de shiny mais caro (preços do Radar)
HUNT_VALOR=1
HUNT_VALOR_FOLGA=0.9
HUNT_VALOR_SEM_DADO=500
# mede o XP/h dos 2 degraus de cima e fica no melhor
HUNT_MEDIR=1
MEDIR_MIN=10
MEDIR_VALIDADE_NIVEIS=5
# degrau de baixo que perdeu por 30% ou mais só é medido de novo depois de 30 níveis
MEDIR_FOLGA=1.3
# só troca de degrau se o outro render 10% a mais e depois de 15 min no atual
HUNT_HISTERESE=1.1
HUNT_PERMANENCIA_MIN=15
MEDIR_PERDEDOR_NIVEIS=30
# poção abaixo desta fração do HP (o jogo vem com 0,3)
HP_LIMIAR=0.6
OURO_RESERVA_BOLAS=3000

# rotina e endgame
TORNEIOS=1
CHOCADEIRA=1
RADAR=1
BOSSES=1
BOSS_NIVEL_MIN=3100
TOKEN_RESERVA=1
RAID=1

# equipe e evolução
GERIR_EQUIPE=1
EVOLUIR=1
EVO_NIVEL_MIN=20
PEDRA_PRECO_MAX=300000
COLECAO_NOTA=1
COLECAO_NOTA_MIN=3.5
# só o ativo luta; reserva ocupa vaga (e tirar da equipe exige ir ao Centro)
EQUIPE_MAX=1
# 1 = equipe com o pokemon mais forte de cada espécie (usa todas as vagas); desliga a Auto Venda e o bot vende na
# hora as capturas mais fracas (nunca shiny, lendário, mega, P4+, acima do Nv 100, nota >= COLECAO_NOTA_MIN, inicial ou Coleção)
TIME_FORTE=0
VENDA_LOTE=20
# só vai ao NPC pokemon com nota abaixo disto (o Mercado aceita 3,5 ou mais; o resto fica guardado para vender a jogadores)
VENDA_NOTA_MAX=3.5
VENDA_MAX_MIN=60
# capturas de nota 3,5 até 5 vão para o altar; 1000 pontos = 14 dias de +20% de XP
SACRIFICIO=1
SACRIFICIO_NOTA_MAX=5
SACRIFICIO_RESGATAR_PTS=1000
# Top Catch: rota semanal por espécies novas. Desligado: vai para hunts de nível 1 (~43 mil XP/h contra ~12 mi) e em 10 h só chega ao Lure de 30 min
TOP_CATCH=0
TOP_CATCH_META=200
TOP_CATCH_HORAS=10
TOP_CATCH_MIN_POR_HORA=4
# Prey: cartela grátis do dia (18h), escolhendo espécie da hunt atual
PREY=1
# PvP Ranqueado: time automático e fila automática do servidor (VIP); prêmio mensal em Gemas para o top 2.000
PVP=1

# Mercado ao vivo (a cada MERCADO_ALERTA_MIN minutos): avisa quando um item da lista fica X% abaixo da média em Gemas,
# e quando um item seu (livre) pode ser anunciado X% acima da média. Só avisa: não compra nem anuncia.
MERCADO_ALERTA=1
MERCADO_ALERTA_MIN=30
ALERTA_ITENS=AoE TM Disk Piece,Mega Stone Fragment,Mega Shiny Stone Fragment
ALERTA_COMPRA_PCT=20
ALERTA_VENDA_PCT=30

# Sniper: COMPRA SOZINHO com Gemas (dinheiro real). Desligado por padrão; ligue por sua conta.
# SNIPER_ITENS = nome:preço máximo por unidade em Gemas:quantidade máxima por dia, separados por vírgula
# ex.: SNIPER_ITENS=AoE TM Disk Piece:370:10,Mega Stone Fragment:90:10
# Só compra abaixo do teto da regra E da média − SNIPER_DESCONTO%, e no máximo SNIPER_ORCAMENTO_DIA Gemas por dia (0 = nada).
# Ignora anúncio abaixo de 10% da média (isca de manipulação). Pedra comprada fica presa à conta (não revende).
SNIPER=0
SNIPER_ITENS=
SNIPER_DESCONTO=10
SNIPER_ORCAMENTO_DIA=0
SNIPER_MIN=5
# Sniper de pokemon: 0 = desligado; observar = só escreve no log o que compraria; 1 = COMPRA SOZINHO com Gemas (dinheiro real).
# O Mercado segura anúncio novo por 2 min e sorteia quem pediu nos 3 primeiros segundos da liberação (quem perde não paga).
# O bot olha os anúncios recentes, compara com vendas reais parecidas (espécie, shiny, potência, AoE, nível próximo, 14 dias)
# e pede na liberação só se a revenda, já sem a taxa, render SNIPER_PK_LUCRO% sobre o preço. Nunca anuncia para revender.
SNIPER_PK=0
SNIPER_PK_SEG=5
SNIPER_PK_MAX=1500
SNIPER_PK_DIA=2000
SNIPER_PK_QTD_DIA=3
SNIPER_PK_RESERVA=500
SNIPER_PK_LUCRO=30
SNIPER_PK_VENDAS=5
SNIPER_PK_SO_SHINY=1
# Revenda: ANUNCIA SOZINHO o que o sniper comprou, SNIPER_PK_ABAIXO Gemas abaixo do menor entre a média e o anúncio
# mais barato, sem descer do que pagou + SNIPER_PK_MARGEM% (já sem a taxa: 13% até 500 Gemas, 10% até 5.000).
SNIPER_PK_REVENDER=0
SNIPER_PK_ABAIXO=10
SNIPER_PK_MARGEM=10
SNIPER_PK_REV_DIAS=3

# pedra de evolução pode usar até esta fração do ouro
PEDRA_FRACAO_MAX=0.6
# abaixo disso, modo economia (hunt pelo ouro/h); 0 = desligado
OURO_PISO=200000

# avisos
AVISO_WINDOWS=1
# canal do app ntfy no celular (invente um nome difícil, ex.: pkidle-7f3a9c2e81d4); vazio = desligado
NTFY_TOPICO=
# painel no celular pela rede de casa (só leitura). 1 liga; a senha precisa de 8 caracteres ou mais
PAINEL_REDE=0
PAINEL_SENHA=

# outros
MANTER_ACORDADO=1
PAUSA_HORAS=2
PAINEL_PORTA=8787
