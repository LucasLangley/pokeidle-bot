# Copie para .env e preencha. Nunca compartilhe o .env: o token é a sua sessão no jogo.
POKEIDLE_NICK=
POKEIDLE_TOKEN=
# opcional: o id do seu navegador (localStorage "id-dispositivo"); vazio = gera um novo
POKEIDLE_DISPOSITIVO=

# 1 = conecta e só mostra o que faria (ainda assim derruba o jogo aberto no navegador)
SOMENTE_LER=0

# captura: vip (padrão: só o Auto-Catch do servidor, precisa de VIP) | sempre | time | rajada (o bot lança sozinho; sem VIP pode ser visto como burlar benefício pago) | 0
CAPTURAR=vip
RAJADA_MS=3000
BOLA_RESERVA=20
MIN_POCOES=60
MIN_REVIVES=10
MIN_BOLAS=100
GASTO_MAX_FRACAO=0.4
AUTO_VENDA=1

# hunt
MARGEM_NIVEL=0
REGIOES=kanto,orre
HUNT_FIXA=
MORTES_PARA_RECUAR=3
OUTLAND_DE=150
OUTLAND_ATE=199
HUNT_POR_TIPO=1
# entre as hunts de tipo bom (até 10% pior que a melhor), fica na de shiny mais caro (preços do Radar)
HUNT_VALOR=1
HUNT_VALOR_FOLGA=0.9
HUNT_VALOR_SEM_DADO=500
# mede o XP/h dos 2 degraus de cima e fica no melhor
HUNT_MEDIR=1
MEDIR_MIN=10
MEDIR_VALIDADE_NIVEIS=5
# poção abaixo desta fração do HP (o jogo vem com 0,3)
HP_LIMIAR=0.6
OURO_RESERVA_BOLAS=3000

# rotina e endgame
TORNEIOS=1
CHOCADEIRA=1
RADAR=1
BOSSES=1
BOSS_NIVEL_MIN=3100
TOKEN_RESERVA=1
RAID=1

# equipe e evolução
GERIR_EQUIPE=1
EVOLUIR=1
EVO_NIVEL_MIN=20
PEDRA_PRECO_MAX=300000
COLECAO_NOTA=1
COLECAO_NOTA_MIN=3.5
# só o ativo luta; reserva ocupa vaga (e tirar da equipe exige ir ao Centro)
EQUIPE_MAX=1
# capturas de nota 3,5 até 5 vão para o altar; 1000 pontos = 14 dias de +20% de XP
SACRIFICIO=1
SACRIFICIO_NOTA_MAX=5
SACRIFICIO_RESGATAR_PTS=1000
# Top Catch: rota semanal por espécies novas (marcos: 100 = Lure 30 min, 150-300 = XP Boost + Lure, 400 = Lure 12 h)
TOP_CATCH=1
TOP_CATCH_META=200
TOP_CATCH_HORAS=10
TOP_CATCH_MIN_POR_HORA=4
# Prey: cartela grátis do dia (18h), escolhendo espécie da hunt atual
PREY=1
# PvP Ranqueado: time automático e fila automática do servidor (VIP); prêmio mensal em Gemas para o top 2.000
PVP=1
# pedra de evolução pode usar até esta fração do ouro
PEDRA_FRACAO_MAX=0.6
# abaixo disso, modo economia (hunt pelo ouro/h); 0 = desligado
OURO_PISO=200000

# avisos
AVISO_WINDOWS=1
# canal do app ntfy no celular (invente um nome difícil, ex.: pkidle-7f3a9c2e81d4); vazio = desligado
NTFY_TOPICO=

# outros
MANTER_ACORDADO=1
PAUSA_HORAS=2
PAINEL_PORTA=8787
